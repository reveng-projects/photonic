#include <windows.h>

#include "../version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PHOTONIC_VERSION_MAJOR,PHOTONIC_VERSION_MINOR,PHOTONIC_VERSION_BUILD,PHOTONIC_VERSION_REVISION
 PRODUCTVERSION PHOTONIC_VERSION_MAJOR,PHOTONIC_VERSION_MINOR,PHOTONIC_VERSION_BUILD,PHOTONIC_VERSION_REVISION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DRV
 FILESUBTYPE VFT2_DRV_SYSTEM
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Photonic FireWire camera driver"
            VALUE "FileVersion", PHOTONIC_VERSION_STRING
            VALUE "InternalName", "photonic.sys"
            VALUE "OriginalFilename", "photonic.sys"
            VALUE "ProductName", "Photonic"
            VALUE "ProductVersion", PHOTONIC_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
