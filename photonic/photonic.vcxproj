  <ItemDefinitionGroup>
    <Link>
      <!-- stream.lib exports StreamClassRegisterAdapter and the
           StreamClass*Notification helpers this minidriver depends on.
           WppRecorder.lib provides the in-memory recorder (WppAutoLog*,
           WppRecorderReplay) used by WPP recorder mode; the WDM toolset does
           not add it automatically the way the KMDF one does. -->
      <AdditionalDependencies>stream.lib;WppRecorder.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <ClCompile>
      <!-- WPP software tracing. Runs the trace preprocessor over every source
           file to emit the .tmh files and ETW plumbing.
             WppEnabled            - turn the WPP build step on.
             WppRecorderEnabled    - also log to the in-memory recorder so the
                                     traces are dumpable in WinDbg with
                                     !rcdrkd.rcdrlogdump without a trace session.
             WppKernelMode         - generate kernel-mode (not user-mode) glue.
             WppScanConfigurationData - the WPP control GUID / begin_wpp config
                                     lives in trace.h, not in the sources, so
                                     point the scanner at it. -->
      <!-- The IOCTL handlers live in the ioctl\ subfolder; $(ProjectDir) lets
           them include the project-root headers (photonic.h, ioctl.h, ...)
           without ..\ prefixes. -->
      <AdditionalIncludeDirectories>$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Fail the build on any compiler warning. -->
      <TreatWarningAsError>true</TreatWarningAsError>
      <WppEnabled>true</WppEnabled>
      <WppRecorderEnabled>true</WppRecorderEnabled>
      <WppKernelMode>true</WppKernelMode>
      <WppScanConfigurationData>trace.h</WppScanConfigurationData>
      <!-- Pin the kernel API surface to Win10 RTM (1507, NTDDI_WIN10 =
           0x0A000000) so the driver does not bind newer exports such as
           ExAllocatePool2 (Win10 2004+). POOL_ZERO_DOWN_LEVEL_SUPPORT makes
           the ExAllocatePoolZero/ExAllocatePoolUninitialized inlines available
           on pre-2004 targets, where they fall back to ExAllocatePoolWithTag.
           Without this the driver fails to load on older Win10 with code 39
           (driver entry point not found). -->
      <PreprocessorDefinitions>NTDDI_VERSION=0x0A000000;POOL_ZERO_DOWN_LEVEL_SUPPORT;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <DriverSign>
      <!-- Recent WDKs require an explicit digest algorithm, otherwise
           signtool runs without /fd and rejects the invocation. -->
      <FileDigestAlgorithm>SHA256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>
